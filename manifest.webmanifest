{
  "name": "LYMN Tools",
  "short_name": "LYMN Tools",
  "description": "Private media tools that run in your browser — compress videos and images without uploading them — plus handy web utilities.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#ffffff",
  "lang": "en",
  "categories": ["utilities", "productivity", "photo"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "shortcuts": [
    { "name": "Video Compressor", "url": "./video-compressor/", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Image Compressor", "url": "./image-compressor/", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Text", "url": "./#text-tool", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
